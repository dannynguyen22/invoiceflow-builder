# Optional cloud sign-in + template sync (see docs/CLOUD_SETUP.md). Leave empty to run as guest-only.
# Copy to .env.local (git-ignored) and fill in YOUR Supabase project values.
#
# Only PUBLIC values belong here: they are bundled into the browser app.
# NEVER put the service_role / secret key in any VITE_* variable; the app refuses to start cloud
# features if it detects one.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
